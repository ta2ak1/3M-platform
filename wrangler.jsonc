{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "3m-platform",
  "compatibility_date": "2026-08-14",
  "main": "./worker/index.ts",
  "ai": {
    "binding": "AI",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "3m-platform-db",
      "database_id": "4bbd1165-ffa1-406a-9885-533db05e7768",
      "migrations_dir": "./migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "3m-platform-photos",
    },
  ],
  "vars": {
    "BUCKET_PUBLIC_URL": "https://3m-platform-photos.r2.dev",
    "CLOUDFLARE_ACCOUNT_ID": "YOUR_CLOUDFLARE_ACCOUNT_ID",
    "AI_GATEWAY_ACCOUNT_ID": "YOUR_AI_GATEWAY_ACCOUNT_ID",
    "AI_GATEWAY_NAME": "YOUR_AI_GATEWAY_NAME",
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/uploads/*"],
  },
}
