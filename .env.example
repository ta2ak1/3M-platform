# Copy this file to `.env` or `.dev.vars` for local development.
# Do not commit real secret values.

BUCKET_PUBLIC_URL=https://3m-platform-photos.r2.dev
CLOUDFLARE_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
AI_GATEWAY_ACCOUNT_ID=YOUR_AI_GATEWAY_ACCOUNT_ID
AI_GATEWAY_NAME=YOUR_AI_GATEWAY_NAME
CLOUDFLARE_API_TOKEN=YOUR_CLOUDFLARE_API_TOKEN

# Cloudflare Turnstile
# Local success-test keys:
# VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
VITE_TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY
